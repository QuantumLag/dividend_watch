# Copy this file to .env.local (which is gitignored) and fill in real values.
# Find these in the Supabase Dashboard -> Project -> Connect, or Settings -> API Keys.

# Safe to expose to the browser (used by the browser + server clients):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never use in a Client Component.
# Used later by your cron job to write market data into dividends_cache.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
