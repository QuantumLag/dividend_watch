# Copy this file to .env.local (which is gitignored) and fill in real values.
# Find these in the Supabase Dashboard -> Project -> Connect, or Settings -> API Keys.

# Safe to expose to the browser (used by the browser + server clients):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never use in a Client Component.
# Used later by your cron job to write market data into dividends_cache.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# DIVIDEND DATA PROVIDER (optional - uses mock data by default)
# Choose one provider: finnhub, polygon, or eod
# DIVIDEND_API_PROVIDER=finnhub
# DIVIDEND_API_KEY=your_api_key_here
# NEXT_PUBLIC_DIVIDEND_API_KEY=your_public_api_key_if_needed

# CRON JOB SECRET (for Vercel deployment security)
# Generate a random secret: openssl rand -base64 32
# Set this in Vercel environment variables as CRON_SECRET
CRON_SECRET=your_random_secret_here

# STRIPE (for Pro plan payments - optional)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

